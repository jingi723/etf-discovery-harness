# Optional: structured market and ETF data from Financial Modeling Prep.
# Copy this file to .env, replace the placeholder, and never commit .env.
FMP_API_KEY=replace-with-your-key

# Optional: Toss Securities Open API (quotes, candles, KR investor flows,
# KR indices/bond yields, FX). https://developers.tossinvest.com
TOSS_CLIENT_ID=replace-with-your-client-id
TOSS_CLIENT_SECRET=replace-with-your-client-secret

# Optional: override Chrome/Chromium detection for PDF and PNG export.
# CHROME_BIN=/absolute/path/to/chrome
